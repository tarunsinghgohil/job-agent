# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER put real secrets in this file — it is the
# one env file intended to be committed.
# ---------------------------------------------------------------------------

# --- Core ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-generate-a-long-random-value
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------
# Local dev default is SQLite (no server needed).
# Production: postgresql+psycopg://user:password@host:5432/jobagent
DATABASE_URL=sqlite+pysqlite:///./data/jobagent.db

# --- Auth ---------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
# Bootstrap owner account, used only by `python -m app.cli seed`.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# --- Web ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATA_DIR=./data

# --- AI -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_CHEAP_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_MONTHLY_BUDGET_USD=25

# --- Job sources --------------------------------------------------------
JOB_SEARCH_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REMOTIVE_ENABLED=true

# --- Notifications ------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
SLACK_WEBHOOK_URL=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# --- Scheduler ----------------------------------------------------------
SCHEDULER_ENABLED=true
TIMEZONE=Asia/Kolkata

# --- Docker compose stack (only needed for `docker compose up`) ---------
# Compose refuses to start without these two, rather than defaulting to
# something predictable.
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=
POSTGRES_DB=jobagent
REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000
